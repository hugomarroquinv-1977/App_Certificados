# Copia este archivo como ".env" en tu máquina y completa los valores.
# El archivo ".env" NO se sube al repositorio; este ejemplo sí.

# Usuario administrador.
ADMIN_CORREO=
ADMIN_CLAVE=

# Usuario normal.
USUARIO_CORREO=
USUARIO_CLAVE=

# Clave para firmar la sesión de Flask (inventa una larga y secreta).
SECRET_KEY=

# Conexión a base de datos (la usa models/datos.py, no la pantalla de entrada).
DATABASE_URL=
